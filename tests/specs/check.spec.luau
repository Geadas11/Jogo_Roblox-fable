-- Shared.Net.Check: the validators every client -> server argument goes through.

local Check = Engine.new().side("server").load("ReplicatedStorage.Shared.Net.Check")

local NAN = 0 / 0

test("number rejects NaN, infinity and non-numbers", function()
	expect.truthy(Check.number(1.5))
	expect.truthy(Check.number(-3))
	expect.falsy(Check.number(NAN))
	expect.falsy(Check.number(math.huge))
	expect.falsy(Check.number(-math.huge))
	expect.falsy(Check.number("1"))
	expect.falsy(Check.number(nil))
end)

test("integer rejects fractions and non-finite values", function()
	expect.truthy(Check.integer(7))
	expect.truthy(Check.integer(-2))
	expect.falsy(Check.integer(7.5))
	expect.falsy(Check.integer(NAN))
	expect.falsy(Check.integer(math.huge))
end)

test("ranges are inclusive and reject values outside", function()
	local range = Check.numberRange(0, 10)
	expect.truthy(range(0))
	expect.truthy(range(10))
	expect.truthy(range(2.5))
	expect.falsy(range(-0.01))
	expect.falsy(range(10.01))
	expect.falsy(range(NAN))

	local integers = Check.integerRange(1, 6)
	expect.truthy(integers(1))
	expect.truthy(integers(6))
	expect.falsy(integers(0))
	expect.falsy(integers(7))
	expect.falsy(integers(2.5))
	expect.throws(function()
		Check.numberRange(5, 1)
	end, "min must be <= max")
end)

test("string enforces a byte limit and valid UTF-8", function()
	local short = Check.string(5)
	expect.truthy(short(""))
	expect.truthy(short("abcde"))
	expect.falsy(short("abcdef"))
	expect.falsy(short(12345))
	expect.falsy(short(nil))
	expect.falsy(short("\255\254"))
end)

test("boolean accepts only booleans", function()
	expect.truthy(Check.boolean(true))
	expect.truthy(Check.boolean(false))
	expect.falsy(Check.boolean(0))
	expect.falsy(Check.boolean("true"))
	expect.falsy(Check.boolean(nil))
end)

test("oneOf accepts only listed values", function()
	local difficulty = Check.oneOf({ "Easy", "Normal", "Hard", "Nightmare" })
	expect.truthy(difficulty("Hard"))
	expect.falsy(difficulty("hard"))
	expect.falsy(difficulty("Impossible"))
	expect.falsy(difficulty(nil))
	expect.falsy(difficulty(NAN))
	expect.falsy(difficulty({}))
end)

test("optional accepts nil and otherwise defers to the inner validator", function()
	local maybe = Check.optional(Check.integer)
	expect.truthy(maybe(nil))
	expect.truthy(maybe(3))
	expect.falsy(maybe(3.5))
	expect.falsy(maybe("3"))
end)

test("instance accepts only instances of the class", function()
	local world = Engine.new()
	local instanceCheck = world.side("server").load("ReplicatedStorage.Shared.Net.Check").instance("BasePart")
	expect.truthy(instanceCheck(world.newInstance("Part", "Box")))
	expect.falsy(instanceCheck(world.newInstance("Folder", "Box")))
	expect.falsy(instanceCheck({
		IsA = function()
			return true
		end,
	}))
	expect.falsy(instanceCheck(nil))
	expect.falsy(instanceCheck("Part"))
end)

test("args rejects extra arguments", function()
	local ok, reason = Check.args({ Check.integer }, 1, 2)
	expect.falsy(ok)
	expect.truthy(string.find(reason, "at most 1", 1, true))

	expect.falsy(Check.args({}, "unexpected"))
	expect.truthy(Check.args({}))
end)

test("args passes missing arguments to their validator as nil", function()
	expect.falsy(Check.args({ Check.integer, Check.boolean }, 1))
	expect.truthy(Check.args({ Check.integer, Check.optional(Check.boolean) }, 1))
end)

test("args reports which argument failed", function()
	local ok, reason = Check.args({ Check.integer, Check.boolean }, 1, "no")
	expect.falsy(ok)
	expect.equal(reason, "argument 2: expected boolean")
end)

test("args counts explicit nils so they cannot hide extra values", function()
	expect.falsy(Check.args({ Check.optional(Check.integer) }, nil, "smuggled"))
end)
