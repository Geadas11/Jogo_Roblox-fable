-- Shared.SessionState: server writes, both sides read the same Attributes.

local function boot()
	local world = Engine.new()
	local server = world.side("server").load("ReplicatedStorage.Shared.SessionState")
	server.Start()
	local client = world.side("client").load("ReplicatedStorage.Shared.SessionState")
	client.Start()
	return world, server, client
end

test("starts with defaults that the client can read", function()
	local world, server, client = boot()
	expect.equal(server.Get("Phase"), "Lobby")
	expect.equal(client.Get("Phase"), "Lobby")
	expect.equal(world.find("ReplicatedStorage.State"):GetAttribute("Phase"), "Lobby")
end)

test("a server write is visible to the client", function()
	local _, server, client = boot()
	server.Set("Phase", "Shift")
	expect.equal(client.Get("Phase"), "Shift")
end)

test("Observe reports the current value, then every change", function()
	local _, server, client = boot()
	local seen = {}
	local connection = client.Observe("Phase", function(value)
		table.insert(seen, value)
	end)
	server.Set("Phase", "Shift")
	server.Set("Phase", "Results")
	connection:Disconnect()
	server.Set("Phase", "Lobby")
	expect.equal(table.concat(seen, ","), "Lobby,Shift,Results")
end)

test("the client cannot write", function()
	local _, _, client = boot()
	expect.throws(function()
		client.Set("Phase", "Results")
	end, "only be called on the server")
end)

test("rejects unknown keys, wrong types and values outside the allowed list", function()
	local _, server = boot()
	expect.throws(function()
		server.Set("Money", 5)
	end, "unknown key")
	expect.throws(function()
		server.Get("Money")
	end, "unknown key")
	expect.throws(function()
		server.Set("Phase", 3)
	end, "expects a string")
	expect.throws(function()
		server.Set("Phase", "Paused")
	end, "cannot be set to")
	expect.equal(server.Get("Phase"), "Lobby")
end)

test("fails clearly when used before Start or when the server never created it", function()
	local world = Engine.new()
	local client = world.side("client").load("ReplicatedStorage.Shared.SessionState")
	expect.throws(function()
		client.Get("Phase")
	end, "before SessionState.Start")
	expect.throws(function()
		client.Start()
	end, "did not appear within")
end)
